# Line-ending and diff policy.
#
# IMPORTANT: the ODB++ samples under cases/ carry sidecar checksum files
# (`.features.sum`, `.profile.sum`, ...) that some downstream CAM tools verify.
# Any line-ending normalisation would silently corrupt those samples, so the
# whole directory is marked binary: git must never touch its bytes.
cases/** -text -diff

# Vendor reference PDF: never diff, never text-convert.
*.pdf -text -diff
# Source, docs and configs: normalise to LF so Linux CI and Windows agree.
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg  text eol=lf
*.sh   text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf
# Generated / third-party content that should not inflate diffs.
*.svg  -diff
*.png  -diff
docs/Flotherm_reference_MaterialMap.csv filter=lfs diff=lfs merge=lfs -text
