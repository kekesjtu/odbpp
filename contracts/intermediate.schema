{
  "$defs": {
    "LayerModel": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "description": "ODB++ 层类型；等效器明确报告不支持的材料类型。",
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "context": {
          "const": "BOARD",
          "default": "BOARD",
          "title": "Context",
          "type": "string"
        },
        "row": {
          "description": "matrix ROW；同一 step 内唯一，表达层的上下次序。",
          "minimum": 1,
          "title": "Row",
          "type": "integer"
        },
        "polygons": {
          "description": "本层图元规整后的正向几何；介质不填充轮廓基底，跨层 DRILL 投影保持独立。",
          "items": {
            "$ref": "#/$defs/PolygonModel"
          },
          "title": "Polygons",
          "type": "array"
        },
        "z_mm": {
          "anyOf": [
            {
              "$ref": "#/$defs/ZExtentModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "实体物理层自身的绝对 Z；DRILL 不保存此字段，由起止铜层推导。"
        },
        "start_layer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "DRILL 起始铜层名称。",
          "title": "Start Layer"
        },
        "end_layer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "DRILL 终止铜层名称。",
          "title": "End Layer"
        }
      },
      "required": [
        "name",
        "type",
        "row",
        "polygons"
      ],
      "title": "LayerModel",
      "type": "object"
    },
    "PolygonModel": {
      "additionalProperties": false,
      "description": "A regularised positive boundary; island=False explicitly denotes a hole.",
      "properties": {
        "island": {
          "title": "Island",
          "type": "boolean"
        },
        "points": {
          "description": "毫米坐标；首点不在末尾重复；至少三个点。",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 3,
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "island",
        "points"
      ],
      "title": "PolygonModel",
      "type": "object"
    },
    "ProfileModel": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "layers": {
          "description": "使用此轮廓的 BOARD 层名称；每层最多归属一个轮廓。",
          "items": {
            "type": "string"
          },
          "title": "Layers",
          "type": "array"
        },
        "polygons": {
          "items": {
            "$ref": "#/$defs/PolygonModel"
          },
          "title": "Polygons",
          "type": "array"
        }
      },
      "required": [
        "id",
        "layers",
        "polygons"
      ],
      "title": "ProfileModel",
      "type": "object"
    },
    "StepModel": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "profile_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "整板轮廓在 profiles 中的引用；不能以铜图案替代。",
          "title": "Profile Id"
        },
        "profiles": {
          "items": {
            "$ref": "#/$defs/ProfileModel"
          },
          "title": "Profiles",
          "type": "array"
        },
        "layers": {
          "description": "按 matrix row 排列的 BOARD 层目录；每个层都带本层几何。",
          "items": {
            "$ref": "#/$defs/LayerModel"
          },
          "title": "Layers",
          "type": "array"
        }
      },
      "required": [
        "name",
        "profiles",
        "layers"
      ],
      "title": "StepModel",
      "type": "object"
    },
    "ZExtentModel": {
      "additionalProperties": false,
      "description": "A physical layer's own position on the absolute Z axis.\n\n``null`` expresses \"not measured\" instead of a boolean flag, so no estimate\ncan be read as a measurement: a null ``start_mm`` says the layers above do\nnot all state their thickness, a null ``thickness_mm`` says this layer's\nown thickness was never stated. ``0.0`` stays a real measurement, and the\ntwo sides are independent -- a known thickness does not imply a known\nposition.",
      "properties": {
        "start_mm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "本层顶面绝对 Z，自叠层顶面向下；null 表示累计位置不可信。",
          "title": "Start Mm"
        },
        "thickness_mm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "本层自身厚度；null 表示格式未声明。",
          "title": "Thickness Mm"
        }
      },
      "title": "ZExtentModel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One physical step, positive polygons, mm XY and absolute downward Z.",
  "properties": {
    "units": {
      "const": "mm",
      "title": "Units",
      "type": "string"
    },
    "path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "输入源路径，用于核对文档来自哪一份输入；手工合成数据可省略。",
      "title": "Path"
    },
    "resolution_mm": {
      "default": 0.0001,
      "description": "规整后坐标网格间距，单位 mm；非材料采样光栅。",
      "exclusiveMinimum": 0,
      "title": "Resolution Mm",
      "type": "number"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/StepModel"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "units",
    "steps"
  ],
  "title": "BoardDocument",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
